import os
import pytest
from scripts.scraper import setup_dirs

def test_setup_dirs_creates_output_folders(tmp_path, monkeypatch):
    monkeypatch.setattr("scripts.scraper.OUTPUT_DIR", str(tmp_path / "output"))
    setup_dirs()
    assert os.path.exists(tmp_path / "output" / "md")
    assert os.path.exists(tmp_path / "output" / "html")
