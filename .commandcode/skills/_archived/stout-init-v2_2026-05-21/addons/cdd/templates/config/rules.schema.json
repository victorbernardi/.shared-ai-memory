{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuração de Regras CDD",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "enabled", "filter", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "priority": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "filter": {
            "type": "object",
            "required": ["operator"],
            "properties": {
              "operator": { "type": "string", "enum": ["and", "or", "not", "eq", "neq", "gt", "gte", "lt", "lte", "in", "nin", "contains", "exists", "isNull", "regex"] },
              "field": { "type": "string" },
              "value": { "type": ["string", "number", "boolean", "null"] },
              "values": { "type": "array" }
            }
          },
          "action": {
            "type": "object",
            "required": ["type", "target"],
            "properties": {
              "type": { "type": "string", "enum": ["activate_skill", "route_to_agent", "execute_tool"] },
              "target": { "type": "string" }
            }
          },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
