# Line-ending policy for the sdd-cmdc-opencode package. The package is a
# deterministic release unit: every tracked source must stay LF/UTF-8 in the
# working tree and in the release manifest, regardless of checkout platform.
# Scope: only the package and its three executable wrappers. The repository
# keeps its default behavior (core.autocrlf) everywhere else.
skills/sdd-cmdc-opencode/**/*.py text eol=lf
skills/sdd-cmdc-opencode/**/*.md text eol=lf
skills/sdd-cmdc-opencode/**/*.json text eol=lf
skills/sdd-cmdc-opencode/scripts/review-package text eol=lf
skills/sdd-cmdc-opencode/scripts/sdd-workspace text eol=lf
skills/sdd-cmdc-opencode/scripts/task-brief text eol=lf
