{
  "env": {
    "CONTEXT_AGENT_ORIGIN": "claude"
  },
  "permissions": {
    "allow": [
      "Edit(C:\\Users\\victor.bernardi\\.claude\\skills\\**)",
      "Bash(mktemp -t handoff-XXXXXX.md)",
      "Read(//c/Users/victor.bernardi/AppData/Local/Temp/claude/**)",
      "Bash(npx claude *)",
      "Bash(where claude *)",
      "Read(//c/Users/victor.bernardi/OneDrive - INOVA EQUIPAMENTOS LTDA/Documentos/WindowsPowerShell/**)",
      "PowerShell($env:CLAUDECODE; $env:CLAUDE_CODE_ENTRYPOINT)",
      "PowerShell($env:CLAUDECODE)",
      "PowerShell($env:CLAUDE_CODE_ENTRYPOINT)",
      "Read(//c/Users/victor.bernardi/AppData/Local/AnthropicClaude/**)",
      "Bash(ls \"C:\\\\Users\\\\victor.bernardi\\\\AppData\\\\Local\\\\AnthropicClaude\" 2>&1 | head -20)",
      "Read(//c/Projetos/**)",
      "Read(//c/Users/victor.bernardi/.gemini/**)",
      "PowerShell(Get-ChildItem -Path \"C:\\\\Users\\\\victor.bernardi\\\\.gemini\\\\antigravity-cli\" -Recurse -Depth 2 2>$null | Where-Object {$_.PSIsContainer} | Select-Object -First 50)",
      "PowerShell(Get-ChildItem -Path \"C:\\\\Users\\\\victor.bernardi\\\\.gemini\" -Force | Where-Object {$_.Name -match '\\(config|settings|state\\)'})",
      "PowerShell(Get-ChildItem -Path \"c:\\\\Users\\\\victor.bernardi\\\\AppData\\\\Local\\\\Programs\\\\\" -Force 2>$null | Where-Object {$_.Name -match 'antigravity|gemini|claude'})",
      "PowerShell(Get-ChildItem -Path \"c:\\\\Users\\\\victor.bernardi\\\\AppData\\\\Local\\\\Programs\\\\Antigravity IDE\\\\\" -Force -Recurse 2>$null | Where-Object {$_.PSIsContainer -eq $false} | Select-Object -First 50)",
      "Read(//c/Users/victor.bernardi/AppData/Local/Programs/Antigravity IDE/bin/**)",
      "Read(//c/Users/victor.bernardi/AppData/Local/Programs/Antigravity IDE/resources/app/extensions/antigravity/bin/**)",
      "Read(//c/Users/victor.bernardi/AppData/Local/Programs/Antigravity/**)",
      "Bash(\"C:\\\\Users\\\\victor.bernardi\\\\AppData\\\\Local\\\\AnthropicClaude\\\\claude.exe\" --version)",
      "Bash(echo \"exit: $?\")"
    ],
    "additionalDirectories": [
      "C:\\Users\\victor.bernardi\\AppData\\Local\\Temp\\claude",
      "C:\\Users\\victor.bernardi\\OneDrive - INOVA EQUIPAMENTOS LTDA\\Documentos\\WindowsPowerShell",
      "C:\\Users\\victor.bernardi\\.gemini"
    ]
  },
  "model": "sonnet",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [ -n \"$FILE\" ] && echo \"$FILE\" | grep -qi '[.]md$'; then npx markdownlint-cli --fix \"$FILE\" 2>/dev/null || true; fi",
            "statusMessage": "Corrigindo markdown..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [ -n \"$FILE\" ] && echo \"$FILE\" | grep -qi \"Obsidian-Victor-Global/wiki\"; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"wiki/ eh somente leitura para Claude Code. Deposite em wiki/raw/_pending/ para o wiki-compiler processar.\"}}'; exit 2; fi",
            "statusMessage": "Verificando permissao de escrita em wiki/..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"C:/Projetos/Stout/wiki-compiler/run_wiki_work.sh\" >> \"C:/Users/victor.bernardi/Documents/Obsidian-Victor-Global/wiki/.hook_log.md\" 2>&1 &"
          },
          {
            "type": "command",
            "command": "uv run --no-project --python 3.12 python \"%USERPROFILE%\\.claude\\skills\\context-agent\\scripts\\save_hook.py\" 2>&1 || true",
            "statusMessage": "Salvando contexto da sessão..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "language": "pt-br",
  "effortLevel": "medium",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
