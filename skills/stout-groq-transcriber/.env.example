# Stout Groq Transcriber — Configuração de Ambiente

# OPÇÃO 1 (recomendado): Usar chave compartilhada do sistema
# Arquivo canônico: ~/.shared-ai-memory/.env
# A chave será carregada automaticamente desse arquivo

# OPÇÃO 2: Configurar localmente (para teste)
# Copie este arquivo para .env na mesma pasta de transcribe.py
# e descomente a linha abaixo

# GROQ_API_KEY=gsk_sua_chave_aqui

# Ou use a nomenclatura alternativa (compatível com system .env)
# Groq_API_Key=gsk_sua_chave_aqui

# Valores padrão (podem ser sobrescritops)
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_CLEANUP_MODEL=llama-3.3-70b-versatile
