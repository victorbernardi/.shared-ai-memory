#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
[[ "$n" =~ ^[0-9]+$ ]] || { echo "task number must be numeric: $n" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

out_dir=$(dirname "$out")
[ -d "$out_dir" ] || {
  echo "output directory does not exist: $out_dir" >&2
  exit 2
}
tmp=$(mktemp "$out_dir/.task-${n}-brief.XXXXXX") || {
  echo "could not create temporary task brief beside $out" >&2
  exit 2
}
cleanup() { rm -f -- "$tmp"; }
trap cleanup EXIT HUP INT TERM

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+([0-9]+[.)]?[ \t]+)?(Task|Tarefa)[ \t]+[0-9]+/ {
    task_heading = "^#+[ \t]+([0-9]+[.)]?[ \t]+)?(Task|Tarefa)[ \t]+[0-9]+([^0-9]|$)"
    wanted_heading = "^#+[ \t]+([0-9]+[.)]?[ \t]+)?(Task|Tarefa)[ \t]+" n "([^0-9]|$)"
    intask = ($0 ~ wanted_heading)
  }
  intask { print }
' "$plan" > "$tmp"

if [ ! -s "$tmp" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}' or 'Tarefa ${n}')" >&2
  exit 3
fi

mv -f -- "$tmp" "$out"
trap - EXIT HUP INT TERM

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
