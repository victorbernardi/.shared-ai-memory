#!/usr/bin/env bash
# Compatibility wrapper for the cross-platform task brief implementation.
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE] [--scope-json SCOPE_FILE]
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if command -v python >/dev/null 2>&1; then
  python_bin=$(command -v python)
elif command -v python3 >/dev/null 2>&1; then
  python_bin=$(command -v python3)
else
  echo "python or python3 is required for task-brief.py" >&2
  exit 2
fi

exec "$python_bin" "$script_dir/task-brief.py" "$@"
